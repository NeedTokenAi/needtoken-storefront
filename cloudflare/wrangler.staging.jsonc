{
  "name": "needtoken-storefront-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "DujiaoStorefront",
      "scheduling_policy": "durable_object",
      "images": {
        "dujiao": {
          "image": "${CLOUDFLARE_IMAGE_DIGEST}"
        },
        "dujiao-previous": {
          "image": "${CLOUDFLARE_IMAGE_DIGEST}"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STOREFRONT",
        "class_name": "DujiaoStorefront"
      }
    ]
  },
  "exports": {
    "DujiaoStorefront": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
