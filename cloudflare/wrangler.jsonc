{
  "name": "needtoken-storefront",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "containers": [
    {
      "class_name": "Storefront",
      "scheduling_policy": "default",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 2,
      "rollout_step_percentage": 100,
      "constraints": {
        "regions": ["APAC"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STOREFRONT",
        "class_name": "Storefront"
      }
    ]
  },
  "exports": {
    "Storefront": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
